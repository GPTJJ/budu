generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  key                          String              @id
  name                         String              @unique
  district                     String              @default("")
  salesDataSource              String              @default("manual") @map("sales_data_source")
  salesDataSourceEffectiveDate DateTime?           @map("sales_data_source_effective_date")
  createdAt                    DateTime            @default(now())
  staff                        Staff[]
  entries                      DailyEntry[]
  dailyStaff                   DailyStoreStaff[]
  stock                        StockBalance[]
  ledger                       StockLedger[]
  transferOut                  TransferRequest[]   @relation("TransferFrom")
  transferIn                   TransferRequest[]   @relation("TransferTo")
  purchases                    PurchaseRequest[]
  waste                        WasteRecord[]
  expenses                     Expense[]
  invoices                     Invoice[]
  bigBonuses                   BigOrderBonus[]
  memberConsumptions           MemberConsumption[]
  orders                       Order[]
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String   @default("staff")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}

model Staff {
  id       String @id
  name     String
  type     String @default("fulltime")
  storeKey String
  salary   Float  @default(0)
  store    Store  @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey])
}

model DailyEntry {
  id                      String    @id
  storeKey                String
  date                    DateTime  @db.Date
  incCents                BigInt    @default(0)
  ord                     Int       @default(0)
  staffNames              Json      @default("[]")
  status                  String    @default("draft")
  salesDataStatus         String    @default("not_applicable") @map("sales_data_status")
  posSyncAt               DateTime? @map("pos_sync_at")
  hybridAdjustmentCents   BigInt    @default(0) @map("hybrid_adjustment_cents")
  hybridAdjustmentNote    String    @default("") @map("hybrid_adjustment_note")
  confirmedAt             DateTime? @map("confirmed_at")
  confirmedBy             String    @default("") @map("confirmed_by")
  version                 Int       @default(1)
  updatedBy               String    @default("")
  updatedAt               DateTime  @default(now()) @updatedAt
  store                   Store     @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date])
}

model DailyStoreStaff {
  id                  String   @id
  storeId             String   @map("store_id")
  date                DateTime @db.Date
  staffId             String   @map("staff_id")
  staffNameSnapshot   String   @default("") @map("staff_name_snapshot")
  shiftId             String   @default("") @map("shift_id")
  scheduledStartTime  String   @default("") @map("scheduled_start_time")
  scheduledEndTime    String   @default("") @map("scheduled_end_time")
  actualStartTime     String   @default("") @map("actual_start_time")
  actualEndTime       String   @default("") @map("actual_end_time")
  breakMinutes        Int      @default(0) @map("break_minutes")
  scheduledHours      Float    @default(0) @map("scheduled_hours")
  actualHours         Float    @default(0) @map("actual_hours")
  attendanceStatus    String   @default("normal") @map("attendance_status")
  source              String   @default("manual")
  createdBy           String   @default("") @map("created_by")
  updatedBy           String   @default("") @map("updated_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  store               Store    @relation(fields: [storeId], references: [key], onDelete: Cascade)

  @@unique([storeId, date, staffId])
  @@index([storeId, date])
  @@map("daily_store_staff")
}

model DailyEntryAuditLog {
  id           String   @id
  storeId      String   @map("store_id")
  date         DateTime @db.Date
  module       String   @default("")
  fieldName    String   @default("") @map("field_name")
  beforeValue  Json?    @map("before_value")
  afterValue   Json?    @map("after_value")
  reason       String   @default("")
  operatorId   String   @default("") @map("operator_id")
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([storeId, date])
  @@map("daily_entry_audit_logs")
}

model InventoryItem {
  id             String         @id
  name           String         @unique
  unit           String         @default("")
  spec           String         @default("")
  barcode        String         @default("")
  category       String         @default("product")
  image          String         @default("")
  sku            String?        @unique
  posCategory    String         @default("")
  salePriceCents BigInt?
  costPriceCents BigInt?
  isActive       Boolean        @default(false)
  trackInventory Boolean        @default(false)
  sortOrder      Int            @default(0)
  version        Int            @default(1)
  updatedAt      DateTime       @default(now()) @updatedAt
  createdAt      DateTime       @default(now())
  balances       StockBalance[]
  ledger         StockLedger[]
  transferItems  TransferItem[]
  purchaseItems  PurchaseItem[]
  waste          WasteRecord[]
  orderItems     OrderItem[]
}

model Order {
  id                  String      @id
  orderNo             String      @unique @map("order_no")
  storeId             String      @map("store_id")
  cashierId           String      @map("cashier_id")
  cashierNameSnapshot String      @default("") @map("cashier_name_snapshot")
  subtotal            BigInt      @default(0)
  discountAmount      BigInt      @default(0) @map("discount_amount")
  payableAmount       BigInt      @default(0) @map("payable_amount")
  businessDate        DateTime?   @db.Date @map("business_date")
  discountPercent     Int         @default(100) @map("discount_percent")
  remark              String      @default("")
  status              String      @default("draft")
  paymentStatus       String      @default("unpaid") @map("payment_status")
  paymentMethod       String?     @map("payment_method")
  paymentMode         String      @default("mock") @map("payment_mode")
  checkoutKey         String      @unique @map("checkout_key")
  cartHash            String      @map("cart_hash")
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  completedAt         DateTime?   @map("completed_at")
  store               Store       @relation(fields: [storeId], references: [key], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  paymentLogs         PaymentLog[]

  @@index([storeId, createdAt])
  @@index([cashierId, createdAt])
  @@index([status, paymentStatus])
  @@map("orders")
}

model Payment {
  id               String    @id
  paymentNo        String    @unique @map("payment_no")
  orderId          String    @map("order_id")
  channel          String
  paymentMethod    String    @default("") @map("payment_method")
  amount           BigInt
  currency         String    @default("CNY")
  status           String    @default("created")
  merchantTradeNo  String    @unique @map("merchant_trade_no")
  providerTradeNo  String?   @unique @map("provider_trade_no")
  provider         String
  requestKey       String    @unique @map("request_key")
  failureCode      String    @default("") @map("failure_code")
  failureMessage   String    @default("") @map("failure_message")
  providerMetadata Json      @default("{}") @map("provider_metadata")
  requestPayload   Json?     @map("request_payload")
  responsePayload  Json?     @map("response_payload")
  rawCallback      Json?     @map("raw_callback")
  callbackCount    Int       @default(0) @map("callback_count")
  lastCallbackId   String    @default("") @map("last_callback_id")
  lastCallbackAt   DateTime? @map("last_callback_at")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  paidAt           DateTime? @map("paid_at")
  failedAt         DateTime? @map("failed_at")
  closedAt         DateTime? @map("closed_at")
  providerStatus   String    @default("") @map("provider_status")
  queryAttempts    Int       @default(0) @map("query_attempts")
  lastQueriedAt    DateTime? @map("last_queried_at")
  nextActionAt     DateTime? @map("next_action_at")
  reconciliationRequired Boolean @default(false) @map("reconciliation_required")
  reconciledAt     DateTime? @map("reconciled_at")
  networkAttemptStartedAt DateTime? @map("network_attempt_started_at")
  reconcileLeaseOwner String @default("") @map("reconcile_lease_owner")
  reconcileLeaseUntil DateTime? @map("reconcile_lease_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds          Refund[]
  paymentLogs      PaymentLog[]

  @@index([orderId, createdAt])
  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

model Refund {
  id               String    @id
  refundNo         String    @unique @map("refund_no")
  orderId          String    @map("order_id")
  paymentId        String    @map("payment_id")
  refundAmount     BigInt    @map("refund_amount")
  reason           String    @default("")
  status           String    @default("pending")
  providerRefundNo String?   @unique @map("provider_refund_no")
  requestKey       String    @unique @map("request_key")
  requestedBy      String    @default("") @map("requested_by")
  approvedBy       String    @default("") @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items            RefundItem[]

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("refunds")
}

model RefundItem {
  id           String    @id
  refundId     String    @map("refund_id")
  orderItemId  String    @map("order_item_id")
  quantity     Int
  amountCents  BigInt    @map("amount_cents")
  createdAt    DateTime  @default(now()) @map("created_at")
  refund       Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

model PaymentLog {
  id              String    @id
  paymentId       String    @map("payment_id")
  orderId         String    @map("order_id")
  storeKey        String    @default("") @map("store_key")
  cashierId       String    @default("") @map("cashier_id")
  event           String
  channel         String    @default("")
  amount          BigInt    @default(0)
  status          String    @default("")
  providerTradeNo String?   @map("provider_trade_no")
  failureCode     String    @default("") @map("failure_code")
  failureMessage  String    @default("") @map("failure_message")
  callbackAt      DateTime? @map("callback_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_logs")
}

model OrderItem {
  id                  String        @id
  orderId             String        @map("order_id")
  productId           String        @map("product_id")
  productNameSnapshot String        @map("product_name_snapshot")
  skuSnapshot         String        @map("sku_snapshot")
  unitSnapshot        String        @default("") @map("unit_snapshot")
  unitPrice           BigInt        @map("unit_price")
  costPriceSnapshot   BigInt        @map("cost_price_snapshot")
  skuId               String        @default("") @map("sku_id")
  quantity            Int
  lineAmount          BigInt        @map("line_amount")
  discountAmount      BigInt        @default(0) @map("discount_amount")
  actualAmount        BigInt        @default(0) @map("actual_amount")
  isGift              Boolean       @default(false) @map("is_gift")
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundItems         RefundItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StockBalance {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int           @default(0)
  minQty    Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeKey, itemId])
}

model StockLedger {
  id        String        @id
  storeKey  String
  itemId    String
  change    Int
  balance   Int
  type      String
  refId     String        @default("")
  note      String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeKey, itemId, createdAt])
}

model TransferRequest {
  id           String         @id
  fromStoreKey String
  toStoreKey   String
  status       String         @default("pending")
  note         String         @default("")
  createdBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  items        TransferItem[]
  fromStore    Store          @relation("TransferFrom", fields: [fromStoreKey], references: [key])
  toStore      Store          @relation("TransferTo", fields: [toStoreKey], references: [key])

  @@index([fromStoreKey, status])
  @@index([toStoreKey, status])
}

model TransferItem {
  id        String          @id
  requestId String
  itemId    String
  quantity  Int
  note      String          @default("")
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item      InventoryItem   @relation(fields: [itemId], references: [id])
}

model PurchaseRequest {
  id          String         @id
  storeKey    String
  status      String         @default("pending")
  supplier    String         @default("")
  supplierId  String?
  expectedAt  DateTime?
  note        String         @default("")
  createdBy   String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
  items       PurchaseItem[]
  store       Store          @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  supplierRef Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([storeKey, status])
}

model Supplier {
  id        String            @id
  name      String            @unique
  phone     String            @default("")
  contact   String            @default("")
  note      String            @default("")
  createdAt DateTime          @default(now())
  purchases PurchaseRequest[]
}

model WasteRecord {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int
  reason    String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AlertLog {
  id        String   @id
  storeKey  String
  itemId    String
  day       String
  createdAt DateTime @default(now())

  @@unique([storeKey, itemId, day])
}

model Expense {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  category    String   @default("其他")
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, date])
}

model Member {
  id           String              @id
  name         String
  phone        String              @unique
  birthday     DateTime?
  level        Int                 @default(0)
  points       Int                 @default(0)
  createdAt    DateTime            @default(now())
  consumptions MemberConsumption[]
}

model Invoice {
  id          String   @id
  storeKey    String
  titleType   String   @default("company")
  companyName String   @default("")
  taxNo       String   @default("")
  amountCents BigInt   @default(0)
  category    String   @default("其他")
  email       String   @default("")
  note        String   @default("")
  status      String   @default("pending")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, createdAt])
  @@index([storeKey, status])
}

model InvoiceCompany {
  id        String   @id
  name      String   @unique
  taxNo     String   @default("")
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model BigOrderBonus {
  id          String   @id
  staffKey    String
  staffName   String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  bonusCents  BigInt   @default(0)
  receipt     String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([staffKey, createdAt])
  @@index([storeKey, createdAt])
}

model DailyPayAdjustment {
  id                   String   @id
  staffName            String   @map("staff_name")
  date                 DateTime @db.Date
  autoPayCentsSnapshot BigInt   @default(0) @map("auto_pay_cents_snapshot")
  adjustedPayCents     BigInt   @default(0) @map("adjusted_pay_cents")
  reason               String   @default("")
  active               Boolean  @default(true)
  createdBy            String   @default("") @map("created_by")
  updatedBy            String   @default("") @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")
  version              Int      @default(1)

  @@unique([staffName, date])
  @@index([date])
  @@map("daily_pay_adjustments")
}

model DailyPayAdjustmentAuditLog {
  id             String   @id
  adjustmentId   String   @map("adjustment_id")
  staffName      String   @map("staff_name")
  date           DateTime @db.Date
  action         String
  beforeValue    Json?    @map("before_value")
  afterValue     Json?    @map("after_value")
  operatorName   String   @default("") @map("operator_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([adjustmentId, createdAt])
  @@index([staffName, date])
  @@map("daily_pay_adjustment_audit_logs")
}

model MemberConsumption {
  id          String   @id
  memberId    String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([memberId, date])
}

model PurchaseItem {
  id          String          @id
  requestId   String
  itemId      String
  orderedQty  Int
  receivedQty Int             @default(0)
  note        String          @default("")
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item        InventoryItem   @relation(fields: [itemId], references: [id])
}

model MailingRecord {
  id        String    @id
  method    String
  postage   String
  fee       String?
  address   String
  recipient String
  phone     String
  remark    String    @default("")
  status    String    @default("pending")
  createdBy String    @default("")
  createdAt DateTime  @default(now())
  shippedAt DateTime?

  @@index([status, createdAt])
}

model AssetFile {
  id               String    @id
  name             String
  category         String
  company          String    @default("")
  storeKey         String    @default("") @map("store_key")
  thumbnail        String    @default("")
  tags             Json      @default("[]")
  description      String    @default("")
  fileType         String    @default("") @map("file_type")
  fileSize         Int       @default(0) @map("file_size")
  storageProvider  String    @default("local") @map("storage_provider")
  storageKey       String    @default("") @map("storage_key")
  currentVersion   Int       @default(1) @map("current_version")
  issuingAuthority String    @default("") @map("issuing_authority")
  licenseNo        String    @default("") @map("license_no")
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  isPermanent      Boolean   @default(false) @map("is_permanent")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String    @default("") @map("created_by")
  updatedBy        String    @default("") @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  versions         AssetFileVersion[]

  @@index([category, deletedAt])
  @@index([storeKey, deletedAt])
  @@index([expiryDate])
  @@map("asset_files")
}

model AssetCategory {
  key       String   @id
  name      String
  builtin   Boolean  @default(false)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("asset_categories")
}

model AssetFileVersion {
  id              String    @id
  fileId          String    @map("file_id")
  version         Int
  name            String
  fileType        String    @default("") @map("file_type")
  fileSize        Int       @default(0) @map("file_size")
  dataUrl         String    @db.Text @map("data_url")
  storageProvider String    @default("local") @map("storage_provider")
  storageKey      String    @default("") @map("storage_key")
  uploaderId      String    @default("") @map("uploader_id")
  uploaderName    String    @default("") @map("uploader_name")
  note            String    @default("")
  createdAt       DateTime  @default(now()) @map("created_at")
  file            AssetFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId])
  @@map("asset_file_versions")
}

model AssetAccessGrant {
  id        String   @id
  userId    String   @unique @map("user_id")
  username  String
  grantedBy String   @default("") @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("asset_access_grants")
}

model AssetOperationLog {
  id        String   @id
  action    String
  userId    String   @default("") @map("user_id")
  username  String   @default("")
  fileId    String   @default("") @map("file_id")
  fileName  String   @default("") @map("file_name")
  storeKey  String   @default("") @map("store_key")
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([fileId])
  @@map("asset_operation_logs")
}

model AssetReminder {
  id         String    @id
  fileId     String    @map("file_id")
  fileName   String    @default("") @map("file_name")
  storeKey   String    @default("") @map("store_key")
  remindType String    @map("remind_type")
  daysLeft   Int       @default(0) @map("days_left")
  sent       Boolean   @default(false)
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([fileId, remindType])
  @@index([createdAt])
  @@map("asset_reminders")
}

model PayrollNotice {
  id             String    @id
  periodType     String    @map("period_type") // month（全职月结）| week（兼职周结）
  periodKey      String    @map("period_key") // 月: '2026-08'；周: 周起始日 '2026-08-10'
  employeeName   String    @map("employee_name")
  storeKey       String    @map("store_key")
  targetUsername String    @default("") @map("target_username")
  snapshot       Json // 每日明细数组 + 汇总快照（发放时固定）
  totalCents     BigInt    @map("total_cents")
  status         String    @default("pending") // pending | confirmed
  confirmedAt    DateTime? @map("confirmed_at")
  confirmedBy    String    @default("") @map("confirmed_by")
  createdBy      String    @default("") @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([targetUsername, status])
  @@index([periodKey])
  @@map("payroll_notices")
}

// ================= 审批中心（通用审批引擎）=================

/** 审批模板：工资审批 / 报销审批（后续可扩展请假/调休/采购/报损） */
model ApprovalTemplate {
  key          String   @id // payroll | expense
  name         String
  description  String   @default("")
  schema       Json // 表单字段定义 [{key,label,type,required,options?,placeholder?}]
  approverRule Json     @map("approver_rule") // {type:'role', role:'developer'} 或 {type:'username', username:'budu'}
  ccRule       Json     @map("cc_rule") // [{type:'role',role:'finance'},{type:'staffField',field:'employee'},{type:'submitter'}]
  active       Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  requests     ApprovalRequest[]

  @@map("approval_templates")
}

/** 审批单：一张单据一条记录，表单数据存 form_data（金额以分存 Number） */
model ApprovalRequest {
  id               String             @id
  requestNo        String             @unique @map("request_no") // AP-YYYYMMDD-XXXX
  templateKey      String             @map("template_key")
  title            String             @default("")
  status           String             @default("draft") // draft|pending|approved|rejected|withdrawn|archived
  formData         Json               @map("form_data")
  amountCents      BigInt             @default(0) @map("amount_cents") // 冗余金额（分），列表排序/财务汇总
  submitterUsername String             @map("submitter_username")
  submitterName    String             @default("") @map("submitter_name")
  approvedAt       DateTime?          @map("approved_at")
  archivedAt       DateTime?          @map("archived_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  template         ApprovalTemplate   @relation(fields: [templateKey], references: [key], onDelete: Restrict)
  nodes            ApprovalNode[]
  ccs              ApprovalCc[]
  attachments      ApprovalAttachment[]
  comments         ApprovalComment[]
  logs             ApprovalLog[]
  notifications    ApprovalNotification[]

  @@index([submitterUsername, status])
  @@index([status, createdAt])
  @@index([templateKey, status])
  @@map("approval_requests")
}

/** 审批节点：提交人 → 审批人 → 抄送人（抄送不进节点表）；支持未来多级审批 */
model ApprovalNode {
  id               String          @id
  requestId        String          @map("request_id")
  nodeIndex        Int             @map("node_index")
  approverUsername String          @map("approver_username")
  status           String          @default("pending") // pending|approved|rejected
  comment          String          @default("")
  actedAt          DateTime?       @map("acted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  request          ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  comments         ApprovalComment[]

  @@index([requestId])
  @@index([approverUsername, status])
  @@map("approval_nodes")
}

/** 抄送：仅结果通知，非审批节点 */
model ApprovalCc {
  id          String          @id
  requestId   String          @map("request_id")
  ccUsername  String          @map("cc_username")
  ccName      String          @default("") @map("cc_name")
  readAt      DateTime?       @map("read_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, ccUsername])
  @@index([ccUsername, readAt])
  @@map("approval_ccs")
}

/** 附件：图片/PDF/Excel，永久保存（PG data_url，可切 COS），在线预览 */
model ApprovalAttachment {
  id               String          @id
  requestId        String?         @map("request_id") // 草稿期可空，提交时回填
  name             String
  fileType         String          @default("") @map("file_type")
  fileSize         Int             @default(0) @map("file_size")
  dataUrl          String          @db.Text @map("data_url")
  storageProvider  String          @default("local") @map("storage_provider")
  storageKey       String          @default("") @map("storage_key")
  uploaderUsername String          @default("") @map("uploader_username")
  createdAt        DateTime        @default(now()) @map("created_at")
  request          ApprovalRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("approval_attachments")
}

/** 审批意见：通过/驳回时的说明 */
model ApprovalComment {
  id        String          @id
  requestId String          @map("request_id")
  nodeId    String?         @map("node_id")
  username  String          @default("")
  userRole  String          @default("") @map("user_role")
  content   String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  node      ApprovalNode?   @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("approval_comments")
}

/** 操作日志：提交/审批/撤回/归档/重新提交 */
model ApprovalLog {
  id        String          @id
  requestId String          @map("request_id")
  action    String // submit|approve|reject|withdraw|archive|resubmit|create
  username  String          @default("")
  detail    String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("approval_logs")
}

/** 站内通知：待办/结果/抄送；channel 预留微信/企微扩展 */
model ApprovalNotification {
  id        String          @id
  requestId String          @map("request_id")
  username  String          @map("username")
  type      String // todo|result|cc
  title     String          @default("")
  content   String          @default("")
  readAt    DateTime?       @map("read_at")
  channel   String          @default("inapp") // inapp | wechat | wecom（预留）
  createdAt DateTime        @default(now()) @map("created_at")
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([username, readAt])
  @@index([requestId])
  @@map("approval_notifications")
}

// ==================== 通知中心（Notification Center）====================
// 唯一通知入口：业务模块只调用通知中心，通道（站内/微信/APP/短信/邮件）由中心统一派发

/** 通知模板：标题/内容占位符渲染、默认优先级、跳转目标 */
model NotificationTemplate {
  key          String  @id
  name         String
  description  String  @default("")
  titleTpl     String
  contentTpl   String
  target       String  @default("") // 跳转目标：staff-payroll / approval / inventory-transfer / finance-invoice / store-mailing / asset-center 等
  defaultPriority String @default("normal") // high | normal | low
  active       Boolean @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@map("notification_templates")
}

/** 站内通知消息：模板/优先级/已读未读/删除/签收 */
model Notification {
  id          String   @id
  username    String
  templateKey String   @default("") @map("template_key")
  title       String
  content     String
  priority    String   @default("normal") // high | normal | low
  status      String   @default("unread") // unread | read | deleted
  ackStatus   String   @default("none") @map("ack_status") // none | pending | confirmed（签收）
  ackAt       DateTime? @map("ack_at")
  ackBy       String   @default("") @map("ack_by")
  target      String   @default("") // 跳转目标（模板或业务指定）
  refType     String   @default("") @map("ref_type")
  refId       String   @default("") @map("ref_id")
  readAt      DateTime? @map("read_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([username, status])
  @@index([username, createdAt])
  @@map("notifications")
}

/** 通知投递记录：通道扩展留痕（inapp/wechat/wecom/email/sms/app） */
model NotificationDelivery {
  id             String   @id
  notificationId String   @map("notification_id")
  channel        String   @default("inapp")
  status         String   @default("sent") // sent | failed | skipped
  error          String   @default("")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@index([notificationId])
  @@map("notification_deliveries")
}

/** 微信绑定：扫码授权一次建立绑定，通知中心据此推送个人微信提醒 */
model WechatBinding {
  id        String   @id
  username  String
  channel   String   @default("wecom") // wecom 企业微信 | mp 公众号
  openId    String
  nickname  String   @default("")
  status    String   @default("active") // active | revoked
  boundAt   DateTime @default(now()) @map("bound_at")
  revokedAt DateTime? @map("revoked_at")

  @@unique([username, channel])
  @@index([username, status])
  @@map("wechat_bindings")
}

/** 微信扫码绑定的一次性 state：只保存随机票据哈希，防伪造与重放 */
model WechatBindState {
  id        String    @id
  stateHash String    @unique @map("state_hash")
  username  String
  channel   String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([username, createdAt])
  @@map("wechat_bind_states")
}

/** 微信绑定安全审计：不保存完整 userid/openid，仅保存脱敏提示 */
model WechatBindingAuditLog {
  id             String   @id
  bindingId      String   @default("") @map("binding_id")
  targetUsername String   @map("target_username")
  channel        String
  action         String
  actorUsername  String   @default("") @map("actor_username")
  identityHint   String   @default("") @map("identity_hint")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([targetUsername, createdAt])
  @@index([actorUsername, createdAt])
  @@map("wechat_binding_audit_logs")
}

// ============ 员工档案（Employee Master Profile，增量新增，不影响现有模型） ============

/// 员工唯一主档：employeeNo 对外可读唯一编号；userId 关联登录账号（可空）
model Employee {
  id               String   @id
  employeeNo       String   @unique @map("employee_no") // BUDU-0001 起，唯一、不随调店/调岗/调薪变化
  name             String
  status           String   @default("ACTIVE") // PROBATION | ACTIVE | LEAVE | SUSPENDED | RESIGNED
  employmentType   String   @default("fulltime") @map("employment_type") // fulltime 全职 | parttime 兼职 | intern 实习 | other 其他（兼容现有枚举）
  hireDate         DateTime? @map("hire_date")
  currentStoreKey  String   @default("") @map("current_store_key")
  userId           String?  @map("user_id")
  position         String   @default("") // 当前岗位
  level            String   @default("") // 当前职级
  avatar           String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  profile          EmployeeProfile?
  bankAccounts     EmployeeBankAccount[]
  contracts        EmployeeContract[]
  salaryHistory    EmployeeSalaryHistory[]
  storeHistory     EmployeeStoreHistory[]
  positionHistory  EmployeePositionHistory[]
  statusHistory    EmployeeStatusHistory[]
  documents        EmployeeDocument[]
  auditLogs        EmployeeAuditLog[]

  @@index([status])
  @@index([currentStoreKey])
  @@map("employees")
}

/// 基本资料 + 紧急联系人 + 身份信息（身份证号加密存储）
model EmployeeProfile {
  id                 String   @id
  employeeId         String   @unique @map("employee_id")
  gender             String   @default("")
  birthDate          DateTime? @map("birth_date")
  phone              String   @default("")
  backupPhone        String   @default("") @map("backup_phone")
  email              String   @default("")
  wechat             String   @default("")
  nationality        String   @default("")
  city               String   @default("")
  address            String   @default("")
  idType             String   @default("identity") @map("id_type") // identity 身份证 | passport 护照 | other
  idNumberEnc        String   @default("") @map("id_number_enc") // AES-256-GCM 加密
  idNumberLast4      String   @default("") @map("id_number_last4") // 用于掩码展示 1101********1234
  idNumberMasked     String   @default("") @map("id_number_masked") // 完整掩码 110101********1234
  idExpiryDate       DateTime? @map("id_expiry_date")
  idPermanent        Boolean  @default(false) @map("id_permanent")
  emergencyName      String   @default("") @map("emergency_name")
  emergencyRelation  String   @default("") @map("emergency_relation")
  emergencyPhone     String   @default("") @map("emergency_phone")
  emergencyBackup    String   @default("") @map("emergency_backup")
  emergencyNote      String   @default("") @map("emergency_note")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@map("employee_profiles")
}

/// 工资银行卡（卡号加密存储；默认只返回掩码）
model EmployeeBankAccount {
  id             String   @id
  employeeId     String   @map("employee_id")
  accountName    String   @default("") @map("account_name")
  cardNumberEnc  String   @map("card_number_enc") // AES-256-GCM 加密
  cardLast4      String   @map("card_last4") // 掩码展示 **** **** **** 6288
  bankName       String   @default("") @map("bank_name")
  bankBranch     String   @default("") @map("bank_branch")
  bankCode       String   @default("") @map("bank_code") // 联行号
  isPayroll      Boolean  @default(true) @map("is_payroll") // 是否工资卡
  status         String   @default("active") // active | inactive
  effectiveDate  DateTime? @map("effective_date")
  note           String   @default("")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, status])
  @@map("employee_bank_accounts")
}

/// 劳动合同（一期记录；到期提醒二期）
model EmployeeContract {
  id               String   @id
  employeeId       String   @map("employee_id")
  contractType     String   @default("") @map("contract_type")
  contractNo       String   @default("") @map("contract_no")
  signDate         DateTime? @map("sign_date")
  startDate        DateTime? @map("start_date")
  endDate          DateTime? @map("end_date")
  isIndefinite     Boolean  @default(false) @map("is_indefinite") // 无固定期限
  probationMonths  Int      @default(0) @map("probation_months")
  status           String   @default("active") // active 有效 | expiring 即将到期 | expired 已到期 | terminated 已终止
  note             String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, status])
  @@map("employee_contracts")
}

/// 调薪历史（不可覆盖；每次调整追加一条）
model EmployeeSalaryHistory {
  id           String   @id
  employeeId   String   @map("employee_id")
  effectiveDate DateTime @map("effective_date")
  oldValue     String   @default("") @map("old_value") // 如 25 元/h
  newValue     String   @default("") @map("new_value")
  salaryType   String   @default("") @map("salary_type") // hourly 时薪 | monthly 月薪 | other
  reason       String   @default("") // 转正调薪 / 年度调薪 ...
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, effectiveDate])
  @@map("employee_salary_history")
}

/// 调店历史
model EmployeeStoreHistory {
  id           String   @id
  employeeId   String   @map("employee_id")
  effectiveDate DateTime @map("effective_date")
  fromStoreKey String   @default("") @map("from_store_key")
  toStoreKey   String   @default("") @map("to_store_key")
  reason       String   @default("")
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, effectiveDate])
  @@map("employee_store_history")
}

/// 调岗 / 职级变更历史
model EmployeePositionHistory {
  id           String   @id
  employeeId   String   @map("employee_id")
  effectiveDate DateTime @map("effective_date")
  fromPosition String   @default("") @map("from_position")
  toPosition   String   @default("") @map("to_position")
  fromLevel    String   @default("") @map("from_level")
  toLevel      String   @default("") @map("to_level")
  reason       String   @default("")
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, effectiveDate])
  @@map("employee_position_history")
}

/// 在职状态历史（入职/转正/离职/返聘；离职 ≠ 删除）
model EmployeeStatusHistory {
  id                String   @id
  employeeId        String   @map("employee_id")
  action            String   @map("action") // HIRE | PROBATION_PASS | LEAVE | SUSPEND | RESIGN | REHIRE
  effectiveDate     DateTime @map("effective_date")
  fromStatus        String   @default("") @map("from_status")
  toStatus          String   @default("") @map("to_status")
  lastWorkDate      DateTime? @map("last_work_date")
  resignType        String   @default("") @map("resign_type") // voluntary 主动 | company 公司 | other
  resignReason      String   @default("") @map("resign_reason")
  handoverStatus    String   @default("") @map("handover_status")
  salarySettled     Boolean  @default(false) @map("salary_settled")
  propertyReturned  Boolean  @default(false) @map("property_returned")
  accountDisabled   Boolean  @default(false) @map("account_disabled")
  rehireAllowed     Boolean  @default(true) @map("rehire_allowed")
  note              String   @default("")
  operatorName      String   @default("") @map("operator_name")
  createdAt         DateTime @default(now()) @map("created_at")

  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, effectiveDate])
  @@map("employee_status_history")
}

/// 员工附件（身份证/合同/健康证等；敏感附件标记，访问必须认证+鉴权）
model EmployeeDocument {
  id           String   @id
  employeeId   String   @map("employee_id")
  documentType String   @default("") @map("document_type") // identity 身份证 | bank 银行卡 | contract 合同 | health 健康证 | other
  fileName     String   @default("") @map("file_name")
  mimeType     String   @default("") @map("mime_type")
  fileSize     Int      @default(0) @map("file_size")
  data         String   @default("") // base64 文件字节（存 PG，沿用 asset local 模式）
  isSensitive  Boolean  @default(false) @map("is_sensitive")
  note         String   @default("")
  uploadedBy   String   @default("") @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, documentType])
  @@map("employee_documents")
}

/// 员工档案审计日志（敏感字段只记 last4 变化，不记完整号码）
model EmployeeAuditLog {
  id           String   @id
  employeeId   String   @map("employee_id")
  action       String   @map("action") // profile.edit | identity.reveal | bank.reveal | bank.edit | salary.change | store.change | position.change | status.change | document.upload | document.delete
  targetType   String   @default("") @map("target_type")
  targetId     String   @default("") @map("target_id")
  beforeValue  Json?    @map("before_value")
  afterValue   Json?    @map("after_value")
  operatorName String   @default("") @map("operator_name")
  operatorRole String   @default("") @map("operator_role")
  createdAt    DateTime @default(now()) @map("created_at")

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, createdAt])
  @@index([action, createdAt])
  @@map("employee_audit_logs")
}
