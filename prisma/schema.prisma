generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  key                String              @id
  name               String              @unique
  district           String              @default("")
  createdAt          DateTime            @default(now())
  staff              Staff[]
  entries            DailyEntry[]
  stock              StockBalance[]
  ledger             StockLedger[]
  transferOut        TransferRequest[]   @relation("TransferFrom")
  transferIn         TransferRequest[]   @relation("TransferTo")
  purchases          PurchaseRequest[]
  waste              WasteRecord[]
  expenses           Expense[]
  invoices           Invoice[]
  bigBonuses         BigOrderBonus[]
  memberConsumptions MemberConsumption[]
  orders             Order[]
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String   @default("staff")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}

model Staff {
  id       String @id
  name     String
  type     String @default("fulltime")
  storeKey String
  salary   Float  @default(0)
  store    Store  @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey])
}

model DailyEntry {
  id         String   @id
  storeKey   String
  date       DateTime @db.Date
  incCents   BigInt   @default(0)
  ord        Int      @default(0)
  staffNames Json     @default("[]")
  version    Int      @default(1)
  updatedBy  String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt
  store      Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date])
}

model InventoryItem {
  id             String         @id
  name           String         @unique
  unit           String         @default("")
  spec           String         @default("")
  barcode        String         @default("")
  category       String         @default("product")
  image          String         @default("")
  sku            String?        @unique
  posCategory    String         @default("")
  salePriceCents BigInt?
  costPriceCents BigInt?
  isActive       Boolean        @default(false)
  trackInventory Boolean        @default(false)
  sortOrder      Int            @default(0)
  version        Int            @default(1)
  updatedAt      DateTime       @default(now()) @updatedAt
  createdAt      DateTime       @default(now())
  balances       StockBalance[]
  ledger         StockLedger[]
  transferItems  TransferItem[]
  purchaseItems  PurchaseItem[]
  waste          WasteRecord[]
  orderItems     OrderItem[]
}

model Order {
  id                  String      @id
  orderNo             String      @unique @map("order_no")
  storeId             String      @map("store_id")
  cashierId           String      @map("cashier_id")
  cashierNameSnapshot String      @default("") @map("cashier_name_snapshot")
  subtotal            BigInt      @default(0)
  discountAmount      BigInt      @default(0) @map("discount_amount")
  payableAmount       BigInt      @default(0) @map("payable_amount")
  status              String      @default("draft")
  paymentStatus       String      @default("unpaid") @map("payment_status")
  paymentMethod       String?     @map("payment_method")
  paymentMode         String      @default("mock") @map("payment_mode")
  checkoutKey         String      @unique @map("checkout_key")
  cartHash            String      @map("cart_hash")
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  completedAt         DateTime?   @map("completed_at")
  store               Store       @relation(fields: [storeId], references: [key], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  paymentLogs         PaymentLog[]

  @@index([storeId, createdAt])
  @@index([cashierId, createdAt])
  @@index([status, paymentStatus])
  @@map("orders")
}

model Payment {
  id               String    @id
  paymentNo        String    @unique @map("payment_no")
  orderId          String    @map("order_id")
  channel          String
  paymentMethod    String    @default("") @map("payment_method")
  amount           BigInt
  currency         String    @default("CNY")
  status           String    @default("created")
  merchantTradeNo  String    @unique @map("merchant_trade_no")
  providerTradeNo  String?   @unique @map("provider_trade_no")
  provider         String
  requestKey       String    @unique @map("request_key")
  failureCode      String    @default("") @map("failure_code")
  failureMessage   String    @default("") @map("failure_message")
  providerMetadata Json      @default("{}") @map("provider_metadata")
  requestPayload   Json?     @map("request_payload")
  responsePayload  Json?     @map("response_payload")
  rawCallback      Json?     @map("raw_callback")
  callbackCount    Int       @default(0) @map("callback_count")
  lastCallbackId   String    @default("") @map("last_callback_id")
  lastCallbackAt   DateTime? @map("last_callback_at")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  paidAt           DateTime? @map("paid_at")
  failedAt         DateTime? @map("failed_at")
  closedAt         DateTime? @map("closed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds          Refund[]
  paymentLogs      PaymentLog[]

  @@index([orderId, createdAt])
  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

model Refund {
  id               String    @id
  refundNo         String    @unique @map("refund_no")
  orderId          String    @map("order_id")
  paymentId        String    @map("payment_id")
  refundAmount     BigInt    @map("refund_amount")
  reason           String    @default("")
  status           String    @default("pending")
  providerRefundNo String?   @unique @map("provider_refund_no")
  requestKey       String    @unique @map("request_key")
  requestedBy      String    @default("") @map("requested_by")
  approvedBy       String    @default("") @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items            RefundItem[]

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("refunds")
}

model RefundItem {
  id           String    @id
  refundId     String    @map("refund_id")
  orderItemId  String    @map("order_item_id")
  quantity     Int
  amountCents  BigInt    @map("amount_cents")
  createdAt    DateTime  @default(now()) @map("created_at")
  refund       Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

model PaymentLog {
  id              String    @id
  paymentId       String    @map("payment_id")
  orderId         String    @map("order_id")
  storeKey        String    @default("") @map("store_key")
  cashierId       String    @default("") @map("cashier_id")
  event           String
  channel         String    @default("")
  amount          BigInt    @default(0)
  status          String    @default("")
  providerTradeNo String?   @map("provider_trade_no")
  failureCode     String    @default("") @map("failure_code")
  failureMessage  String    @default("") @map("failure_message")
  callbackAt      DateTime? @map("callback_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_logs")
}

model OrderItem {
  id                  String        @id
  orderId             String        @map("order_id")
  productId           String        @map("product_id")
  productNameSnapshot String        @map("product_name_snapshot")
  skuSnapshot         String        @map("sku_snapshot")
  unitSnapshot        String        @default("") @map("unit_snapshot")
  unitPrice           BigInt        @map("unit_price")
  costPriceSnapshot   BigInt        @map("cost_price_snapshot")
  quantity            Int
  lineAmount          BigInt        @map("line_amount")
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundItems         RefundItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StockBalance {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int           @default(0)
  minQty    Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeKey, itemId])
}

model StockLedger {
  id        String        @id
  storeKey  String
  itemId    String
  change    Int
  balance   Int
  type      String
  refId     String        @default("")
  note      String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeKey, itemId, createdAt])
}

model TransferRequest {
  id           String         @id
  fromStoreKey String
  toStoreKey   String
  status       String         @default("pending")
  note         String         @default("")
  createdBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  items        TransferItem[]
  fromStore    Store          @relation("TransferFrom", fields: [fromStoreKey], references: [key])
  toStore      Store          @relation("TransferTo", fields: [toStoreKey], references: [key])

  @@index([fromStoreKey, status])
  @@index([toStoreKey, status])
}

model TransferItem {
  id        String          @id
  requestId String
  itemId    String
  quantity  Int
  note      String          @default("")
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item      InventoryItem   @relation(fields: [itemId], references: [id])
}

model PurchaseRequest {
  id          String         @id
  storeKey    String
  status      String         @default("pending")
  supplier    String         @default("")
  supplierId  String?
  expectedAt  DateTime?
  note        String         @default("")
  createdBy   String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
  items       PurchaseItem[]
  store       Store          @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  supplierRef Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([storeKey, status])
}

model Supplier {
  id        String            @id
  name      String            @unique
  phone     String            @default("")
  contact   String            @default("")
  note      String            @default("")
  createdAt DateTime          @default(now())
  purchases PurchaseRequest[]
}

model WasteRecord {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int
  reason    String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AlertLog {
  id        String   @id
  storeKey  String
  itemId    String
  day       String
  createdAt DateTime @default(now())

  @@unique([storeKey, itemId, day])
}

model Expense {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  category    String   @default("其他")
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, date])
}

model Member {
  id           String              @id
  name         String
  phone        String              @unique
  birthday     DateTime?
  level        Int                 @default(0)
  points       Int                 @default(0)
  createdAt    DateTime            @default(now())
  consumptions MemberConsumption[]
}

model Invoice {
  id          String   @id
  storeKey    String
  titleType   String   @default("company")
  companyName String   @default("")
  taxNo       String   @default("")
  amountCents BigInt   @default(0)
  category    String   @default("其他")
  email       String   @default("")
  note        String   @default("")
  status      String   @default("pending")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, createdAt])
  @@index([storeKey, status])
}

model InvoiceCompany {
  id        String   @id
  name      String   @unique
  taxNo     String   @default("")
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model BigOrderBonus {
  id          String   @id
  staffKey    String
  staffName   String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  bonusCents  BigInt   @default(0)
  receipt     String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([staffKey, createdAt])
  @@index([storeKey, createdAt])
}

model MemberConsumption {
  id          String   @id
  memberId    String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([memberId, date])
}

model PurchaseItem {
  id          String          @id
  requestId   String
  itemId      String
  orderedQty  Int
  receivedQty Int             @default(0)
  note        String          @default("")
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item        InventoryItem   @relation(fields: [itemId], references: [id])
}

model MailingRecord {
  id        String    @id
  method    String
  postage   String
  fee       String?
  address   String
  recipient String
  phone     String
  remark    String    @default("")
  status    String    @default("pending")
  createdBy String    @default("")
  createdAt DateTime  @default(now())
  shippedAt DateTime?

  @@index([status, createdAt])
}
