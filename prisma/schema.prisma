generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  key          String           @id
  name         String           @unique
  district     String           @default("")
  createdAt    DateTime         @default(now())
  staff        Staff[]
  entries      DailyEntry[]
  stock        StockBalance[]
  ledger       StockLedger[]
  transferOut  TransferRequest[] @relation("TransferFrom")
  transferIn   TransferRequest[] @relation("TransferTo")
  purchases    PurchaseRequest[]
  waste        WasteRecord[]
  expenses     Expense[]
  invoices     Invoice[]
  bigBonuses   BigOrderBonus[]
  memberConsumptions MemberConsumption[]
  meituanMappings MeituanStoreMapping[]
  dailySales      DailySales[]
  dishDaily       DishDaily[]
}

model MeituanStoreMapping {
  id             String   @id
  meituanStoreId String   @unique
  storeKey       String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)
}

model DailySales {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  incCents    BigInt   @default(0)
  ord         Int      @default(0)
  refundCents BigInt   @default(0)
  channels    Json     @default("[]")
  source      String   @default("meituan")
  updatedAt   DateTime @default(now()) @updatedAt
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date])
}

model DishDaily {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  dishName    String
  productName String   @default("")
  sales       Int      @default(0)
  amountCents BigInt   @default(0)
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date, dishName])
}

model DishMapping {
  id          String   @id
  dishName    String   @unique
  productName String
  createdAt   DateTime @default(now())
}

model MeituanSyncLog {
  id             String   @id
  meituanStoreId String   @default("")
  storeKey       String   @default("")
  day            String   @default("")
  status         String   @default("ok")
  message        String   @default("")
  durationMs     Int      @default(0)
  createdAt      DateTime @default(now())
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String   @default("staff")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}

model Staff {
  id       String @id
  name     String
  type     String @default("fulltime")
  storeKey String
  salary   Float  @default(0)
  store    Store  @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey])
}

model DailyEntry {
  id         String   @id
  storeKey   String
  date       DateTime @db.Date
  incCents   BigInt   @default(0)
  ord        Int      @default(0)
  staffNames Json     @default("[]")
  version    Int      @default(1)
  updatedBy  String   @default("")
  updatedAt  DateTime @default(now()) @updatedAt
  store      Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date])
}

model InventoryItem {
  id             String          @id
  name           String          @unique
  unit           String          @default("")
  spec           String          @default("")
  barcode        String          @default("")
  category       String          @default("product")
  image          String          @default("")
  createdAt      DateTime        @default(now())
  balances       StockBalance[]
  ledger         StockLedger[]
  transferItems  TransferItem[]
  purchaseItems  PurchaseItem[]
  waste          WasteRecord[]
}

model StockBalance {
  id        String   @id
  storeKey  String
  itemId    String
  quantity  Int      @default(0)
  minQty    Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt
  store     Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeKey, itemId])
}

model StockLedger {
  id        String   @id
  storeKey  String
  itemId    String
  change    Int
  balance   Int
  type      String
  refId     String   @default("")
  note      String   @default("")
  operator  String   @default("")
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeKey, itemId, createdAt])
}

model TransferRequest {
  id           String         @id
  fromStoreKey String
  toStoreKey   String
  status       String         @default("pending")
  note         String         @default("")
  createdBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  items        TransferItem[]
  fromStore    Store          @relation("TransferFrom", fields: [fromStoreKey], references: [key])
  toStore      Store          @relation("TransferTo", fields: [toStoreKey], references: [key])

  @@index([fromStoreKey, status])
  @@index([toStoreKey, status])
}

model TransferItem {
  id        String          @id
  requestId String
  itemId    String
  quantity  Int
  note      String          @default("")
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item      InventoryItem   @relation(fields: [itemId], references: [id])
}

model PurchaseRequest {
  id         String          @id
  storeKey   String
  status     String          @default("pending")
  supplier   String          @default("")
  supplierId String?
  expectedAt DateTime?
  note       String          @default("")
  createdBy  String          @default("")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now())
  items      PurchaseItem[]
  store      Store           @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  supplierRef Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([storeKey, status])
}

model Supplier {
  id        String           @id
  name      String           @unique
  phone     String           @default("")
  contact   String           @default("")
  note      String           @default("")
  createdAt DateTime         @default(now())
  purchases PurchaseRequest[]
}

model WasteRecord {
  id        String   @id
  storeKey  String
  itemId    String
  quantity  Int
  reason    String   @default("")
  operator  String   @default("")
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AlertLog {
  id        String   @id
  storeKey  String
  itemId    String
  day       String
  createdAt DateTime @default(now())

  @@unique([storeKey, itemId, day])
}

model Expense {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  category    String   @default("其他")
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, date])
}

model Member {
  id        String   @id
  name      String
  phone     String   @unique
  birthday  DateTime?
  level     Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  consumptions MemberConsumption[]
}

model Invoice {
  id          String   @id
  storeKey    String
  titleType   String   @default("company")
  companyName String   @default("")
  taxNo       String   @default("")
  amountCents BigInt   @default(0)
  category    String   @default("其他")
  email       String   @default("")
  note        String   @default("")
  status      String   @default("pending")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, createdAt])
  @@index([storeKey, status])
}

model InvoiceCompany {
  id        String   @id
  name      String   @unique
  taxNo     String   @default("")
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model BigOrderBonus {
  id          String   @id
  staffKey    String
  staffName   String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  bonusCents  BigInt   @default(0)
  receipt     String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([staffKey, createdAt])
  @@index([storeKey, createdAt])
}

model MemberConsumption {
  id         String   @id
  memberId   String
  storeKey   String
  date       DateTime @db.Date
  amountCents BigInt  @default(0)
  note       String   @default("")
  createdAt  DateTime @default(now())
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([memberId, date])
}

model PurchaseItem {
  id          String          @id
  requestId   String
  itemId      String
  orderedQty  Int
  receivedQty Int             @default(0)
  note        String          @default("")
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item        InventoryItem   @relation(fields: [itemId], references: [id])
}

model MailingRecord {
  id        String   @id
  method    String
  postage   String
  fee       String?
  address   String
  recipient String
  phone     String
  remark    String   @default("")
  status    String   @default("pending")
  createdBy String   @default("")
  createdAt DateTime @default(now())
  shippedAt DateTime?

  @@index([status, createdAt])
}
