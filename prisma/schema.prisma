generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  key                          String              @id
  name                         String              @unique
  district                     String              @default("")
  salesDataSource              String              @default("manual") @map("sales_data_source")
  salesDataSourceEffectiveDate DateTime?           @map("sales_data_source_effective_date")
  createdAt                    DateTime            @default(now())
  staff                        Staff[]
  entries                      DailyEntry[]
  dailyStaff                   DailyStoreStaff[]
  stock                        StockBalance[]
  ledger                       StockLedger[]
  transferOut                  TransferRequest[]   @relation("TransferFrom")
  transferIn                   TransferRequest[]   @relation("TransferTo")
  purchases                    PurchaseRequest[]
  waste                        WasteRecord[]
  expenses                     Expense[]
  invoices                     Invoice[]
  bigBonuses                   BigOrderBonus[]
  memberConsumptions           MemberConsumption[]
  orders                       Order[]
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String
  role         String   @default("staff")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}

model Staff {
  id       String @id
  name     String
  type     String @default("fulltime")
  storeKey String
  salary   Float  @default(0)
  store    Store  @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey])
}

model DailyEntry {
  id                      String    @id
  storeKey                String
  date                    DateTime  @db.Date
  incCents                BigInt    @default(0)
  ord                     Int       @default(0)
  staffNames              Json      @default("[]")
  status                  String    @default("draft")
  salesDataStatus         String    @default("not_applicable") @map("sales_data_status")
  posSyncAt               DateTime? @map("pos_sync_at")
  hybridAdjustmentCents   BigInt    @default(0) @map("hybrid_adjustment_cents")
  hybridAdjustmentNote    String    @default("") @map("hybrid_adjustment_note")
  confirmedAt             DateTime? @map("confirmed_at")
  confirmedBy             String    @default("") @map("confirmed_by")
  version                 Int       @default(1)
  updatedBy               String    @default("")
  updatedAt               DateTime  @default(now()) @updatedAt
  store                   Store     @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@unique([storeKey, date])
}

model DailyStoreStaff {
  id                  String   @id
  storeId             String   @map("store_id")
  date                DateTime @db.Date
  staffId             String   @map("staff_id")
  staffNameSnapshot   String   @default("") @map("staff_name_snapshot")
  shiftId             String   @default("") @map("shift_id")
  scheduledStartTime  String   @default("") @map("scheduled_start_time")
  scheduledEndTime    String   @default("") @map("scheduled_end_time")
  actualStartTime     String   @default("") @map("actual_start_time")
  actualEndTime       String   @default("") @map("actual_end_time")
  breakMinutes        Int      @default(0) @map("break_minutes")
  scheduledHours      Float    @default(0) @map("scheduled_hours")
  actualHours         Float    @default(0) @map("actual_hours")
  attendanceStatus    String   @default("normal") @map("attendance_status")
  source              String   @default("manual")
  createdBy           String   @default("") @map("created_by")
  updatedBy           String   @default("") @map("updated_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  store               Store    @relation(fields: [storeId], references: [key], onDelete: Cascade)

  @@unique([storeId, date, staffId])
  @@index([storeId, date])
  @@map("daily_store_staff")
}

model DailyEntryAuditLog {
  id           String   @id
  storeId      String   @map("store_id")
  date         DateTime @db.Date
  module       String   @default("")
  fieldName    String   @default("") @map("field_name")
  beforeValue  Json?    @map("before_value")
  afterValue   Json?    @map("after_value")
  reason       String   @default("")
  operatorId   String   @default("") @map("operator_id")
  operatorName String   @default("") @map("operator_name")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([storeId, date])
  @@map("daily_entry_audit_logs")
}

model InventoryItem {
  id             String         @id
  name           String         @unique
  unit           String         @default("")
  spec           String         @default("")
  barcode        String         @default("")
  category       String         @default("product")
  image          String         @default("")
  sku            String?        @unique
  posCategory    String         @default("")
  salePriceCents BigInt?
  costPriceCents BigInt?
  isActive       Boolean        @default(false)
  trackInventory Boolean        @default(false)
  sortOrder      Int            @default(0)
  version        Int            @default(1)
  updatedAt      DateTime       @default(now()) @updatedAt
  createdAt      DateTime       @default(now())
  balances       StockBalance[]
  ledger         StockLedger[]
  transferItems  TransferItem[]
  purchaseItems  PurchaseItem[]
  waste          WasteRecord[]
  orderItems     OrderItem[]
}

model Order {
  id                  String      @id
  orderNo             String      @unique @map("order_no")
  storeId             String      @map("store_id")
  cashierId           String      @map("cashier_id")
  cashierNameSnapshot String      @default("") @map("cashier_name_snapshot")
  subtotal            BigInt      @default(0)
  discountAmount      BigInt      @default(0) @map("discount_amount")
  payableAmount       BigInt      @default(0) @map("payable_amount")
  businessDate        DateTime?   @db.Date @map("business_date")
  discountPercent     Int         @default(100) @map("discount_percent")
  remark              String      @default("")
  status              String      @default("draft")
  paymentStatus       String      @default("unpaid") @map("payment_status")
  paymentMethod       String?     @map("payment_method")
  paymentMode         String      @default("mock") @map("payment_mode")
  checkoutKey         String      @unique @map("checkout_key")
  cartHash            String      @map("cart_hash")
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at")
  completedAt         DateTime?   @map("completed_at")
  store               Store       @relation(fields: [storeId], references: [key], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  refunds             Refund[]
  paymentLogs         PaymentLog[]

  @@index([storeId, createdAt])
  @@index([cashierId, createdAt])
  @@index([status, paymentStatus])
  @@map("orders")
}

model Payment {
  id               String    @id
  paymentNo        String    @unique @map("payment_no")
  orderId          String    @map("order_id")
  channel          String
  paymentMethod    String    @default("") @map("payment_method")
  amount           BigInt
  currency         String    @default("CNY")
  status           String    @default("created")
  merchantTradeNo  String    @unique @map("merchant_trade_no")
  providerTradeNo  String?   @unique @map("provider_trade_no")
  provider         String
  requestKey       String    @unique @map("request_key")
  failureCode      String    @default("") @map("failure_code")
  failureMessage   String    @default("") @map("failure_message")
  providerMetadata Json      @default("{}") @map("provider_metadata")
  requestPayload   Json?     @map("request_payload")
  responsePayload  Json?     @map("response_payload")
  rawCallback      Json?     @map("raw_callback")
  callbackCount    Int       @default(0) @map("callback_count")
  lastCallbackId   String    @default("") @map("last_callback_id")
  lastCallbackAt   DateTime? @map("last_callback_at")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  paidAt           DateTime? @map("paid_at")
  failedAt         DateTime? @map("failed_at")
  closedAt         DateTime? @map("closed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds          Refund[]
  paymentLogs      PaymentLog[]

  @@index([orderId, createdAt])
  @@index([orderId, status])
  @@index([provider, status])
  @@map("payments")
}

model Refund {
  id               String    @id
  refundNo         String    @unique @map("refund_no")
  orderId          String    @map("order_id")
  paymentId        String    @map("payment_id")
  refundAmount     BigInt    @map("refund_amount")
  reason           String    @default("")
  status           String    @default("pending")
  providerRefundNo String?   @unique @map("provider_refund_no")
  requestKey       String    @unique @map("request_key")
  requestedBy      String    @default("") @map("requested_by")
  approvedBy       String    @default("") @map("approved_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  items            RefundItem[]

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("refunds")
}

model RefundItem {
  id           String    @id
  refundId     String    @map("refund_id")
  orderItemId  String    @map("order_item_id")
  quantity     Int
  amountCents  BigInt    @map("amount_cents")
  createdAt    DateTime  @default(now()) @map("created_at")
  refund       Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([refundId])
  @@index([orderItemId])
  @@map("refund_items")
}

model PaymentLog {
  id              String    @id
  paymentId       String    @map("payment_id")
  orderId         String    @map("order_id")
  storeKey        String    @default("") @map("store_key")
  cashierId       String    @default("") @map("cashier_id")
  event           String
  channel         String    @default("")
  amount          BigInt    @default(0)
  status          String    @default("")
  providerTradeNo String?   @map("provider_trade_no")
  failureCode     String    @default("") @map("failure_code")
  failureMessage  String    @default("") @map("failure_message")
  callbackAt      DateTime? @map("callback_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
  @@map("payment_logs")
}

model OrderItem {
  id                  String        @id
  orderId             String        @map("order_id")
  productId           String        @map("product_id")
  productNameSnapshot String        @map("product_name_snapshot")
  skuSnapshot         String        @map("sku_snapshot")
  unitSnapshot        String        @default("") @map("unit_snapshot")
  unitPrice           BigInt        @map("unit_price")
  costPriceSnapshot   BigInt        @map("cost_price_snapshot")
  skuId               String        @default("") @map("sku_id")
  quantity            Int
  lineAmount          BigInt        @map("line_amount")
  discountAmount      BigInt        @default(0) @map("discount_amount")
  actualAmount        BigInt        @default(0) @map("actual_amount")
  isGift              Boolean       @default(false) @map("is_gift")
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             InventoryItem @relation(fields: [productId], references: [id], onDelete: Restrict)
  refundItems         RefundItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model StockBalance {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int           @default(0)
  minQty    Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeKey, itemId])
}

model StockLedger {
  id        String        @id
  storeKey  String
  itemId    String
  change    Int
  balance   Int
  type      String
  refId     String        @default("")
  note      String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([storeKey, itemId, createdAt])
}

model TransferRequest {
  id           String         @id
  fromStoreKey String
  toStoreKey   String
  status       String         @default("pending")
  note         String         @default("")
  createdBy    String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now())
  items        TransferItem[]
  fromStore    Store          @relation("TransferFrom", fields: [fromStoreKey], references: [key])
  toStore      Store          @relation("TransferTo", fields: [toStoreKey], references: [key])

  @@index([fromStoreKey, status])
  @@index([toStoreKey, status])
}

model TransferItem {
  id        String          @id
  requestId String
  itemId    String
  quantity  Int
  note      String          @default("")
  request   TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item      InventoryItem   @relation(fields: [itemId], references: [id])
}

model PurchaseRequest {
  id          String         @id
  storeKey    String
  status      String         @default("pending")
  supplier    String         @default("")
  supplierId  String?
  expectedAt  DateTime?
  note        String         @default("")
  createdBy   String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now())
  items       PurchaseItem[]
  store       Store          @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  supplierRef Supplier?      @relation(fields: [supplierId], references: [id])

  @@index([storeKey, status])
}

model Supplier {
  id        String            @id
  name      String            @unique
  phone     String            @default("")
  contact   String            @default("")
  note      String            @default("")
  createdAt DateTime          @default(now())
  purchases PurchaseRequest[]
}

model WasteRecord {
  id        String        @id
  storeKey  String
  itemId    String
  quantity  Int
  reason    String        @default("")
  operator  String        @default("")
  createdAt DateTime      @default(now())
  store     Store         @relation(fields: [storeKey], references: [key], onDelete: Cascade)
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model AlertLog {
  id        String   @id
  storeKey  String
  itemId    String
  day       String
  createdAt DateTime @default(now())

  @@unique([storeKey, itemId, day])
}

model Expense {
  id          String   @id
  storeKey    String
  date        DateTime @db.Date
  category    String   @default("其他")
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, date])
}

model Member {
  id           String              @id
  name         String
  phone        String              @unique
  birthday     DateTime?
  level        Int                 @default(0)
  points       Int                 @default(0)
  createdAt    DateTime            @default(now())
  consumptions MemberConsumption[]
}

model Invoice {
  id          String   @id
  storeKey    String
  titleType   String   @default("company")
  companyName String   @default("")
  taxNo       String   @default("")
  amountCents BigInt   @default(0)
  category    String   @default("其他")
  email       String   @default("")
  note        String   @default("")
  status      String   @default("pending")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([storeKey, createdAt])
  @@index([storeKey, status])
}

model InvoiceCompany {
  id        String   @id
  name      String   @unique
  taxNo     String   @default("")
  updatedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model BigOrderBonus {
  id          String   @id
  staffKey    String
  staffName   String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  bonusCents  BigInt   @default(0)
  receipt     String   @default("")
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([staffKey, createdAt])
  @@index([storeKey, createdAt])
}

model MemberConsumption {
  id          String   @id
  memberId    String
  storeKey    String
  date        DateTime @db.Date
  amountCents BigInt   @default(0)
  note        String   @default("")
  createdAt   DateTime @default(now())
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  store       Store    @relation(fields: [storeKey], references: [key], onDelete: Cascade)

  @@index([memberId, date])
}

model PurchaseItem {
  id          String          @id
  requestId   String
  itemId      String
  orderedQty  Int
  receivedQty Int             @default(0)
  note        String          @default("")
  request     PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item        InventoryItem   @relation(fields: [itemId], references: [id])
}

model MailingRecord {
  id        String    @id
  method    String
  postage   String
  fee       String?
  address   String
  recipient String
  phone     String
  remark    String    @default("")
  status    String    @default("pending")
  createdBy String    @default("")
  createdAt DateTime  @default(now())
  shippedAt DateTime?

  @@index([status, createdAt])
}

model AssetFile {
  id               String    @id
  name             String
  category         String
  company          String    @default("")
  storeKey         String    @default("") @map("store_key")
  tags             Json      @default("[]")
  description      String    @default("")
  fileType         String    @default("") @map("file_type")
  fileSize         Int       @default(0) @map("file_size")
  storageProvider  String    @default("local") @map("storage_provider")
  storageKey       String    @default("") @map("storage_key")
  currentVersion   Int       @default(1) @map("current_version")
  issuingAuthority String    @default("") @map("issuing_authority")
  licenseNo        String    @default("") @map("license_no")
  issueDate        DateTime? @map("issue_date")
  expiryDate       DateTime? @map("expiry_date")
  isPermanent      Boolean   @default(false) @map("is_permanent")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String    @default("") @map("created_by")
  updatedBy        String    @default("") @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  versions         AssetFileVersion[]

  @@index([category, deletedAt])
  @@index([storeKey, deletedAt])
  @@index([expiryDate])
  @@map("asset_files")
}

model AssetFileVersion {
  id              String    @id
  fileId          String    @map("file_id")
  version         Int
  name            String
  fileType        String    @default("") @map("file_type")
  fileSize        Int       @default(0) @map("file_size")
  dataUrl         String    @db.Text @map("data_url")
  storageProvider String    @default("local") @map("storage_provider")
  storageKey      String    @default("") @map("storage_key")
  uploaderId      String    @default("") @map("uploader_id")
  uploaderName    String    @default("") @map("uploader_name")
  note            String    @default("")
  createdAt       DateTime  @default(now()) @map("created_at")
  file            AssetFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId])
  @@map("asset_file_versions")
}

model AssetAccessGrant {
  id        String   @id
  userId    String   @unique @map("user_id")
  username  String
  grantedBy String   @default("") @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("asset_access_grants")
}

model AssetOperationLog {
  id        String   @id
  action    String
  userId    String   @default("") @map("user_id")
  username  String   @default("")
  fileId    String   @default("") @map("file_id")
  fileName  String   @default("") @map("file_name")
  storeKey  String   @default("") @map("store_key")
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([fileId])
  @@map("asset_operation_logs")
}

model AssetReminder {
  id         String    @id
  fileId     String    @map("file_id")
  fileName   String    @default("") @map("file_name")
  storeKey   String    @default("") @map("store_key")
  remindType String    @map("remind_type")
  daysLeft   Int       @default(0) @map("days_left")
  sent       Boolean   @default(false)
  notifiedAt DateTime? @map("notified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([fileId, remindType])
  @@index([createdAt])
  @@map("asset_reminders")
}
