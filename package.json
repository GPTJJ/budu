{
  "name": "budu-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BUDU 甜品门店管理系统 Dashboard",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:critical": "node scripts/run-tests.mjs critical",
    "dev": "vite",
    "build": "vite build",
    "postinstall": "npm run build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "test:inventory": "node scripts/test-inventory-workflow.mjs",
    "test:pos": "node --test scripts/test-pos-core.mjs",
    "test:pos-order-summary": "node --test scripts/test-pos-order-summary.mjs",
    "test:payments": "node --test scripts/test-payment-foundation.mjs",
    "test:camera": "node --test scripts/test-camera-scanner.mjs",
    "test:swipe-back": "node --test scripts/test-swipe-back.mjs",
    "test:startup": "node --test scripts/test-startup-performance.mjs",
    "test:homepage": "node --test scripts/test-homepage-lightweight.mjs",
    "test:slimming": "node --test scripts/test-system-slimming.mjs",
    "test:home:browser": "playwright test tests/home-workspace.spec.mjs",
    "test:pos-daily": "node --test scripts/test-pos-daily.mjs",
    "test:product-excel": "node --test scripts/test-product-excel.mjs",
    "test:employee-excel": "node --test scripts/test-employee-pay-excel.mjs",
    "test:daily-pay-adjustment": "node --test scripts/test-daily-pay-adjustment.mjs",
    "test:permissions": "node --test scripts/test-account-permissions.mjs",
    "test:permissions:api": "node scripts/test-role-module-api.mjs",
    "test:pos:browser": "playwright test tests/pos-ipad.spec.mjs",
    "test:ssr": "node scripts/smoke-render.mjs",
    "migrate:pg": "node scripts/migrate-kv-to-pg.mjs",
    "reconcile:pg": "node scripts/migrate-kv-to-pg.mjs --reconcile",
    "test:wechat-signature": "node --test scripts/test-wechat-v2-signature.mjs",
    "test:wechat-provider": "node --test scripts/test-wechat-pay-provider.mjs",
    "test:payment-reconciler": "node --test scripts/test-payment-reconciliation.mjs",
    "test:wechat-config": "node --test scripts/test-wechat-config.mjs",
    "test:ocr-integrity": "node --test scripts/test-ocr-input-integrity.mjs",
    "test:wechat-e2e": "node --test scripts/test-wechat-pay-e2e.mjs",
    "test:report-center:rc2a": "node scripts/test-report-center-rc2a.mjs",
    "test:report-center:rc2a-migration": "node --test scripts/test-report-center-rc2a-migration-rehearsal.mjs",
    "test:report-center:rc2b:allocation": "node --test scripts/test-report-center-rc2b-allocation.mjs"
    ,"test:report-center:rc2b": "node scripts/test-report-center-rc2b.mjs",
    "test:report-center:rc2b-migration": "node --test scripts/test-report-center-rc2b-migration-rehearsal.mjs",
    "test:report-center:rc2c": "node scripts/test-report-center-rc2c.mjs",
    "test:report-center:rc2c:ui": "node --test scripts/test-report-center-rc2c-ui-utils.mjs && playwright test tests/report-center-rc2c-pos.spec.mjs tests/report-center-rc2c-refund.spec.mjs",
    "test:report-center:rc3:source": "node --test scripts/test-report-center-rc3-source.mjs",
    "test:report-center:rc3": "node scripts/test-report-center-rc3.mjs",
    "test:report-center:rc4": "node --test scripts/test-report-center-rc4-ui-utils.mjs && node scripts/test-report-center-rc3.mjs",
    "test:report-center:rc5": "node --test scripts/test-report-center-rc3-source.mjs scripts/test-report-center-rc4-ui-utils.mjs && playwright test --project=ipad-webkit --workers=1 tests/report-center-rc5.spec.mjs tests/report-center-rc4.spec.mjs",
    "test:report-center:rc6a": "node --test scripts/test-report-center-rc6a.mjs && playwright test --config=playwright.rc6a.config.mjs --project=ipad-webkit --workers=1",
    "test:report-center:rc6a-migration": "node --test scripts/test-report-center-rc6a-migration-rehearsal.mjs",
    "test:report-center:rc6b": "node --test scripts/test-report-center-rc6a.mjs scripts/test-report-center-rc6b.mjs && playwright test --config=playwright.rc6b.config.mjs --project=ipad-webkit --workers=1",
    "test:report-center:final": "npm run test:report-center:rc2a && npm run test:report-center:rc2b && npm run test:report-center:rc2c && npm run test:report-center:rc3 && npm run test:report-center:rc5 && npm run test:report-center:rc6a && npm run test:report-center:rc6b"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "cookie-parser": "^1.4.7",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "sharp": "^0.34.5",
    "tencentcloud-sdk-nodejs-ocr": "^4.1.287",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
