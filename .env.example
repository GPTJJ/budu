# ===== BUDU 环境变量模板 =====
# 开发：复制为 .env.local（已被 git 忽略）
# 生产：复制为服务器上的 .env.production（/opt/budu 下，已被 git 忽略）

# ---- 服务 ----
# 服务端口（容器内固定 3000，一般无需修改）
PORT=3000

# ---- 运行环境（dev / test / prod）----
# 本地开发默认 dev；测试服务器=test；北京生产=prod
APP_ENV=dev
# 部署时由 CI/脚本注入当前提交号（可选，用于 /api/health 与 Sentry release）
GIT_SHA=
# 微信扫码回调与通知卡片跳转的公网 HTTPS 基址（生产必须填写正式域名，不含路径）
PUBLIC_BASE_URL=https://buducandy.cn

# ---- Sentry 错误监控（可选，未配置则不启用）----
# 后端 DSN（服务端，不进入前端）
SENTRY_DSN=
# 前端 DSN（Vite 构建时注入，注意会进入前端产物）
VITE_SENTRY_DSN=

# JWT 登录令牌密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 迁移到腾讯云时建议先留空：Upstash 模式下服务会自动使用线上数据里的 meta.secret，
# 保证现有登录不失效；后续再改为环境变量注入。
JWT_SECRET=

# 生产环境 HTTPS 下必须为 1，Cookie 仅通过 HTTPS 发送
COOKIE_SECURE=1

# ---- 数据存储（二选一）----
# 方式 A：Upstash KV（当前 Vercel 生产环境在用；腾讯云迁移期推荐，零数据迁移、可随时切回）
# DATA_STORE 留空或填 redis
DATA_STORE=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 只读令牌（可选，仅供备份脚本使用，避免备份误写生产数据）
KV_REST_API_READ_ONLY_TOKEN=

# 方式 B：服务器本地 JSON（生产必须显式设置 DATA_STORE=file 与 DATA_DIR）
# 数据落在 /app/server/data/db.json（docker 持久卷），需自行定时备份
# DATA_STORE=file
# DATA_DIR=/app/server/data

# ---- Nginx / HTTPS（docker compose 插值用，也可放在 /opt/budu/.env）----
# 正式域名，例如 budu.example.com
DOMAIN=budu.example.com
# 1 = 仅 HTTP（首次部署、证书未就绪时临时使用）；0 = HTTPS（正式）
HTTP_ONLY=0

# ---- 预留：PostgreSQL + Prisma（P1 阶段启用）----
# PostgreSQL（M2 已启用；生产密码必须修改并放入服务器 .env.production / .env）
DATABASE_URL=postgresql://budu:CHANGE_ME@postgres:5432/budu
POSTGRES_USER=budu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budu

# ---- 档案馆对象存储（可选）----
# 配置后上传自动存入腾讯云 COS，数据库只保留路径；不配置则继续存 PostgreSQL
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ---- 微信个人提醒通道（通知中心：工资条/审批/调货/发票/邮寄/资产到期等站内通知
#      同步推送微信个人提醒，点击直达对应页面；未配置时自动降级为仅站内）----
# 通道一：企业微信自建应用（推荐；员工扫码授权一次即绑定；corpId/agentId/secret 三者齐备即启用）
#   获取：企业微信管理后台 → 应用管理 → 自建应用（agentId/secret）；我的企业 → 企业ID（corpId）
WXWORK_CORP_ID=
WXWORK_AGENT_ID=
WXWORK_SECRET=
# CustomerRequest（Mailing/Invoice）固定 BUDU 账号 → 企业微信 UserID；不得填写姓名或角色。
CUSTOMER_REQUEST_WECOM_RECIPIENT_USERNAME=
CUSTOMER_REQUEST_WECOM_RECIPIENT_USER_ID=
# 企业微信接收消息服务器验证（应用管理 → 接收消息 → URL/Token/EncodingAESKey；
# 仅用于绑定回调验签，不影响推送；两项必须显式配置，缺失时回调端点关闭；
# URL 填 {PUBLIC_BASE_URL}/api/v2/wechat/recv）
WXWORK_RECV_TOKEN=
WXWORK_RECV_AES_KEY=
# 通道二：公众号模板消息（WXWORK_* 未配置时启用；需 appId/secret/templateId 三件套）
# MP_APP_ID=
# MP_APP_SECRET=
# MP_TEMPLATE_ID=

# 企业微信群机器人 Webhook（告警推送；留空则只走站内通知）
WECHAT_WORK_WEBHOOK_URL=

# 腾讯云 COS（备份同步；子账号密钥仅授权该桶读写；桶建议配置生命周期规则 30 天过期）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---- POS 支付 ----
# 支付模式：mock = 模拟支付（本地/测试默认）；live = 真实支付准备（现金即时完成，
# 微信/支付宝 Provider 未显式开启且配置完整前保持 fail closed，不会调用真实支付接口）
PAYMENT_MODE=mock

# 微信付款码支付（APIv2 MICROPAY；正式接入前配置，禁止提交到 Git）
# 协议：直连商户付款码支付（V2 XML）；不要使用 APIv3 密钥/证书占位配置。
# 灰度开关：0 = 关闭（默认，按钮不出现）；1 = 开启（还需配置完整 + 门店授权 + PAYMENT_MODE=live）
WECHAT_PAY_ENABLED=0
WECHAT_PAY_PROTOCOL=v2_micropay
WECHAT_PAY_MCHID=
WECHAT_PAY_APPID=
# APIv2 密钥与商户 API 证书/私钥只通过 Secret 文件注入（禁止多行环境变量）
WECHAT_PAY_API_V2_KEY_FILE=
WECHAT_PAY_CERT_FILE=
WECHAT_PAY_PRIVATE_KEY_FILE=
# 终端 IP（付款码支付必填：公网可路由 IPv4。拒绝回环/私网/CGNAT/文档 TEST-NET/
# 组播/保留段/IPv6/localhost，绝不回退 127.0.0.1；规则唯一实现见 server/payments/terminal-ip.js）
WECHAT_PAY_TERMINAL_IP=
# 灰度门店名单（逗号分隔 storeKey；留空 = 全部门店）
WECHAT_PAY_ENABLED_STORES=
# 未决支付自动核对参数（可选；非法/不安全值回退安全默认）
# 默认：间隔 5s / 最多 12 次查询 / 60s 后撤销 / 租约 = 安全最小租约
# 时限推导（见 wechat-v2-client.js）：
#   单次 request 硬上限 = 主备域名 × (连接 5s + 请求 10s) = 30s
#   Provider 绝对时限（查询+撤销+复查）= 3 × 30s = 90s
#   安全最小租约 = 绝对时限 90s + 显式安全边际 30s = 120s
# WECHAT_PAY_QUERY_INTERVAL_MS=5000
# WECHAT_PAY_MAX_QUERIES=12
# WECHAT_PAY_REVERSE_AFTER_MS=60000
# WECHAT_PAY_LEASE_MS=120000
# 已受理微信退款的后台查询间隔（可选，范围 5s–300s，默认 30s）
# WECHAT_REFUND_QUERY_INTERVAL_MS=30000

# 支付宝付款码支付（OpenAPI V3 / RSA2；默认关闭，禁止提交任何真实密钥）
ALIPAY_ENABLED=0
ALIPAY_PROTOCOL=openapi_v3_barcode
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_ENDPOINT=https://openapi.alipay.com
ALIPAY_NOTIFY_URL=
# 应用私钥与支付宝公钥只通过只读 Secret 文件注入
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY_FILE=
# 灰度门店名单（逗号分隔 storeKey；留空 = 全部门店）
ALIPAY_ENABLED_STORES=
# ALIPAY_REQUEST_TIMEOUT_MS=10000
# ALIPAY_QUERY_INTERVAL_MS=5000
# ALIPAY_MAX_QUERIES=12
# ALIPAY_REVERSE_AFTER_MS=60000
# ALIPAY_LEASE_MS=120000
# ALIPAY_REFUND_QUERY_INTERVAL_MS=30000

# 腾讯云 OCR（发票图片自动识别抬头/税号/金额；未配置时发票页仍可手动填写）
# 密钥建议使用子账号：访问管理 → 用户 → API 密钥，授权 QcloudOCRFullAccess
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
