# ===== BUDU 环境变量模板 =====
# 开发：复制为 .env.local（已被 git 忽略）
# 生产：复制为服务器上的 .env.production（/opt/budu 下，已被 git 忽略）

# ---- 服务 ----
# 服务端口（容器内固定 3000，一般无需修改）
PORT=3000

# ---- 运行环境（dev / test / prod）----
# 本地开发默认 dev；测试服务器=test；北京生产=prod
APP_ENV=dev
# 部署时由 CI/脚本注入当前提交号（可选，用于 /api/health 与 Sentry release）
GIT_SHA=

# ---- Sentry 错误监控（可选，未配置则不启用）----
# 后端 DSN（服务端，不进入前端）
SENTRY_DSN=
# 前端 DSN（Vite 构建时注入，注意会进入前端产物）
VITE_SENTRY_DSN=

# JWT 登录令牌密钥。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 迁移到腾讯云时建议先留空：Upstash 模式下服务会自动使用线上数据里的 meta.secret，
# 保证现有登录不失效；后续再改为环境变量注入。
JWT_SECRET=

# 生产环境 HTTPS 下必须为 1，Cookie 仅通过 HTTPS 发送
COOKIE_SECURE=1

# ---- 数据存储（二选一）----
# 方式 A：Upstash KV（当前 Vercel 生产环境在用；腾讯云迁移期推荐，零数据迁移、可随时切回）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 只读令牌（可选，仅供备份脚本使用，避免备份误写生产数据）
KV_REST_API_READ_ONLY_TOKEN=

# 方式 B：服务器本地 JSON（不填任何 KV 变量即自动启用）
# 数据落在 /app/server/data/db.json（docker 持久卷），需自行定时备份

# ---- Nginx / HTTPS（docker compose 插值用，也可放在 /opt/budu/.env）----
# 正式域名，例如 budu.example.com
DOMAIN=budu.example.com
# 1 = 仅 HTTP（首次部署、证书未就绪时临时使用）；0 = HTTPS（正式）
HTTP_ONLY=0

# ---- 预留：PostgreSQL + Prisma（P1 阶段启用）----
# PostgreSQL（M2 已启用；生产密码必须修改并放入服务器 .env.production / .env）
DATABASE_URL=postgresql://budu:CHANGE_ME@postgres:5432/budu
POSTGRES_USER=budu
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=budu

# ---- 档案馆对象存储（可选）----
# 配置后上传自动存入腾讯云 COS，数据库只保留路径；不配置则继续存 PostgreSQL
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=

# ---- 预留：企业微信（P8 阶段启用）----
# WECHAT_WORK_CORP_ID=
# WECHAT_WORK_AGENT_ID=
# WECHAT_WORK_SECRET=
# WECHAT_WORK_CALLBACK_TOKEN=
# WECHAT_WORK_CALLBACK_AES_KEY=

# 企业微信群机器人 Webhook（告警推送；留空则只走站内通知）
WECHAT_WORK_WEBHOOK_URL=

# 腾讯云 COS（备份同步；子账号密钥仅授权该桶读写；桶建议配置生命周期规则 30 天过期）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---- POS 支付 ----
# 支付模式：mock = 模拟支付（本地/测试默认）；live = 真实支付准备（现金即时完成，
# 微信/支付宝 Provider 未配置商户参数前会返回 501，不会调用真实支付接口）
PAYMENT_MODE=mock

# 微信支付（正式接入前配置，禁止提交到 Git）
# WECHAT_PAY_MCHID=
# WECHAT_PAY_APPID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_CERT_SERIAL=
# WECHAT_PAY_PRIVATE_KEY=

# 支付宝（正式接入前配置，禁止提交到 Git）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_PID=

# 腾讯云 OCR（发票图片自动识别抬头/税号/金额；未配置时发票页仍可手动填写）
# 密钥建议使用子账号：访问管理 → 用户 → API 密钥，授权 QcloudOCRFullAccess
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
